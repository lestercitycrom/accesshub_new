{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "delivery:qa": "npm run delivery:qa:seed && npm run delivery:qa:screenshots",
        "delivery:qa:seed": "php artisan tinker scripts/delivery-qa/seed.php",
        "delivery:qa:screenshots": "node scripts/delivery-qa/screenshots.mjs",
        "delivery:e2e": "node scripts/delivery-qa/e2e.mjs",
        "smoke:production": "node scripts/deploy/production-smoke.mjs"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.1.11",
        "autoprefixer": "^10.4.20",
        "axios": "^1.7.4",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0",
        "tailwindcss": "^4.0.7",
        "vite": "^7.0.4"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "devDependencies": {
        "playwright": "^1.61.0"
    }
}
